# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# --- Environment ---
.venv/
.env

# --- Data (large / regenerable — never commit the data itself) ---
# Ignore the directory CONTENTS but keep the folder via .gitkeep, so the
# structure exists on a fresh clone; notebook 00 repopulates it.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# --- Model artifacts — regenerable ones are ignored. The TF-IDF vectorizer
# and the trained NN are COMMITTED canonical artifacts: max_features
# tie-breaking and NN training are not reproducible across machines
# (docs/decisions.md), so their canonical bytes live in git.
artifacts/*
!artifacts/README.md
!artifacts/tfidf_vectorizer.joblib
!artifacts/nn_model.keras

# --- OS ---
.DS_Store

# outputs/{figures,tables,predictions} ARE committed (paper deliverables +
# cross-lane handoff) and are intentionally not ignored here.
